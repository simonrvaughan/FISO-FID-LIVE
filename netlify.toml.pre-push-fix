[build]
publish = "."
functions = "netlify/functions"

  [build.environment]

  [build.processing]

    [build.processing.css]

    [build.processing.html]

    [build.processing.images]

    [build.processing.js]

  [build.services]

[functions]

  [functions.pib-scheduled-update]
  schedule = "*/15 * * * *"

  [functions."*"]

[[headers]]
for = "/*"

  [headers.values]
  X-Robots-Tag = "noindex, nofollow, noarchive, nosnippet, noimageindex"
  X-Frame-Options = "DENY"
  X-Content-Type-Options = "nosniff"
  Referrer-Policy = "no-referrer"
  Permissions-Policy = "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=()"
  Content-Security-Policy = "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"

[[headers]]
for = "/index.html"

  [headers.values]
  Cache-Control = "no-store, max-age=0"

[[headers]]
for = "/firebase-messaging-sw.js"

  [headers.values]
  Cache-Control = "no-cache, max-age=0"

[[headers]]
for = "/app.js"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/ffapp-auth.js"

  [headers.values]
  Cache-Control = "no-store, max-age=0"

[[headers]]
for = "/notamengine.js"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/metarengine.js"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/customlocations.js"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/flightroutes.js"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/geometry.js"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/aviationdata.js"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/conflictengine.js"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/hazdam.js"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/styles.css"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/red-arrows-plane.png"

  [headers.values]
  Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
for = "/icons/*"

  [headers.values]
  Cache-Control = "public, max-age=604800"

[[redirects]]
from = "/api/adsb"
to = "/.netlify/functions/adsb-proxy"
status = 200
force = false

  [redirects.query]

  [redirects.conditions]

  [redirects.headers]

[[redirects]]
from = "/api/pib"
to = "/.netlify/functions/pib-proxy"
status = 200
force = false

  [redirects.query]

  [redirects.conditions]

  [redirects.headers]

[[redirects]]
from = "/api/pib-diagnostic"
to = "/.netlify/functions/pib-diagnostic"
status = 200
force = false

  [redirects.query]

  [redirects.conditions]

  [redirects.headers]

[[redirects]]
from = "/api/pib-cache"
to = "/.netlify/functions/pib-cache"
status = 200
force = false

  [redirects.query]

  [redirects.conditions]

  [redirects.headers]